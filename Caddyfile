:5173 {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy app:80
	}

	@backend_assets path /storage /storage/* /uploads /uploads/*
	handle @backend_assets {
		reverse_proxy app:80
	}

	@site_assets path /favicon.svg
	handle @site_assets {
		reverse_proxy frontend:80
	}

	@hrms path /hrms /hrms/*
	handle @hrms {
		redir /hrms /hrms/ 308
		handle_path /hrms/* {
			reverse_proxy frontend:80
		}
	}

	handle / {
		redir /hrms/ 308
	}

	handle {
		respond "Not found" 404
	}
}

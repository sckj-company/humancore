APP_NAME=HumaCore
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP:5173
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_AO

LOG_CHANNEL=stack
LOG_STACK=stderr,single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=humancore
DB_USERNAME=humancore
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=redis

MAIL_MAILER=log

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PASSWORD_RESET_CODE_TTL=15
PASSWORD_RESET_MAX_ATTEMPTS=5

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_OCR_MODEL=qwen/qwen3.8-27b
GROQ_OCR_MAX_IMAGES=3
GROQ_OCR_MAX_PDF_PAGES=3
GROQ_OCR_MAX_COMPLETION_TOKENS=256
GROQ_OCR_MAX_PROMPT_WORDS=80
GROQ_OCR_MAX_IMAGE_BYTES=12582912
